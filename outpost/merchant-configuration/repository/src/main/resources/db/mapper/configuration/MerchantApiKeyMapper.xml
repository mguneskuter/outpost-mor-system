<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.outpost.account.configuration.repository.mybatis.MerchantApiKeyMapper">
  <resultMap id="merchantApiKey" type="com.outpost.account.configuration.MerchantApiKey">
    <constructor>
      <idArg column="account_id" javaType="_long" />
      <arg column="hmac_secret" javaType="string" />
    </constructor>
  </resultMap>
  <select id="findActiveMerchantApiKeyByApiKeyHash" resultMap="merchantApiKey">
    SELECT account_id, hmac_secret
    FROM merchant_api_key
    WHERE api_key_hash = #{apiKeyHash}
      AND is_active
  </select>
</mapper>
