<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.outpost.platform.staticdata.job.accounting.AccountingRequestStatusWriteMapper">
  <select id="findAll" resultType="com.outpost.accounting.queue.repository.AccountingRequestStatusRecord">
    SELECT accounting_request_status_type_id, accounting_request_status_type_code
    FROM accounting_request_status_type ORDER BY accounting_request_status_type_id
  </select>
  <insert id="insert">
    INSERT INTO accounting_request_status_type (accounting_request_status_type_id, accounting_request_status_type_code)
    VALUES (#{accountingRequestStatusId}, #{code})
  </insert>
</mapper>
