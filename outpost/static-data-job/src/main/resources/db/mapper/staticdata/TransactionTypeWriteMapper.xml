<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.outpost.platform.staticdata.job.accounting.TransactionTypeWriteMapper">
  <select id="findAll" resultType="com.outpost.accounting.repository.TransactionTypeRecord">
    SELECT transaction_type_id, code FROM transaction_type ORDER BY transaction_type_id
  </select>
  <insert id="insert" parameterType="com.outpost.accounting.repository.TransactionTypeRecord">
    INSERT INTO transaction_type (transaction_type_id, code)
    VALUES (#{transactionTypeId}, #{code})
  </insert>
</mapper>
