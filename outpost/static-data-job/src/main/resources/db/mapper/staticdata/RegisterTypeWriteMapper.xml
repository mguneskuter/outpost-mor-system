<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.outpost.platform.staticdata.job.accounting.RegisterTypeWriteMapper">
  <select id="findAll" resultType="com.outpost.accounting.repository.RegisterTypeRecord">
    SELECT register_type_id, register_type_code FROM register_type ORDER BY register_type_id
  </select>
  <insert id="insert" parameterType="com.outpost.accounting.repository.RegisterTypeRecord">
    INSERT INTO register_type (register_type_id, register_type_code)
    VALUES (#{registerTypeId}, #{code})
  </insert>
</mapper>
