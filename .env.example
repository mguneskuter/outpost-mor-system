# Local PostgreSQL development database.
# Copy this file to .env and set OUTPOST_DB_PASSWORD to a non-development value.
OUTPOST_DB_PORT=5432
OUTPOST_DB_USER=outpost
OUTPOST_DB_PASSWORD=change-me
OUTPOST_PSP_SIMULATOR_BASE_URL=http://localhost:8083
OUTPOST_PSP_SIMULATOR_API_KEY=demo-outpost-api-key
OUTPOST_PSP_SIMULATOR_HMAC_SECRET=demo-hmac-secret
OUTPOST_OPERATOR_API_KEY=fake-operator-key
OUTPOST_HMAC_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
OUTPOST_LEDGER_GATEWAY_HMAC_SECRET=change-me-gateway-ledger
OUTPOST_WORKER_LEDGER_HMAC_SECRET=change-me-worker-ledger
